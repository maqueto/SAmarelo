# Copie este arquivo para .env.local (uso local) e configure as MESMAS
# variáveis em Vercel → Settings → Environment Variables (uso em produção).
# NUNCA cometa o arquivo .env.local real no Git.

# URL do seu projeto Supabase (Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service Role Key do Supabase (Settings → API → service_role)
# ATENÇÃO: essa chave dá acesso total ao banco. Nunca a exponha no front-end.
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Senha de acesso ao painel /admin.html — escolha algo forte
ADMIN_PASSWORD=escolha-uma-senha-forte-aqui

# Segredo usado para assinar o cookie de sessão do admin — string aleatória longa
# Gere uma com: openssl rand -hex 32
JWT_SECRET=gere-uma-string-aleatoria-longa-aqui
